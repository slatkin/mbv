{
  "ignore": [
    "**/tests/**",
    "**/tests.rs",
    "**/*_tests.rs",
    "**/test_*.rs"
  ],
  "format": {
    "enabled": false
  },
  "autofix": {
    "enabled": false
  },
  "actionableWarnings": {
    "autoFix": {
      "enabled": false
    }
  },
  "lsp": {
    "disabledServers": [
      "typos"
    ]
  },
  "rules": {
    "rust-unwrap": {
      "disable": ["rust-unwrap"]
    },
    "rust-2024-let-chain-candidate": {
      "disable": ["rust-2024-let-chain-candidate"]
    }
  }
}
