# Maintainer: slatkin@gmail.com
pkgname=mbv-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Terminal client for Emby media server (git)"
arch=('x86_64')
url="https://github.com/slatkin/mbv"
license=('MIT')
depends=('mpv' 'openssl' 'gtk4' 'gtk4-layer-shell')
makedepends=('rust' 'cargo' 'nasm' 'git' 'zig' 'gtk4' 'gtk4-layer-shell')
provides=('mbv')
conflicts=('mbv')
source=("${pkgname}::git+https://github.com/slatkin/mbv.git")
sha256sums=('SKIP')

pkgver() {
    cd "${pkgname}"
    git describe --tags --long | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cd "${pkgname}"
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "${pkgname}"
    cargo build --frozen --release --features pinning
}

package() {
    cd "${pkgname}"
    install -Dm755 "target/release/mbv" "${pkgdir}/usr/bin/mbv"
    install -Dm755 "target/release/mbvd" "${pkgdir}/usr/bin/mbvd"
    install -Dm644 "contrib/mbv.desktop" "${pkgdir}/usr/share/applications/mbv.desktop"
    install -Dm644 "assets/icon.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/mbv.svg"
    install -Dm644 "scripts/mbv.lua" "${pkgdir}/usr/share/mbv/scripts/mbv.lua"
    for script in scripts/mbv_*.lua; do
        install -Dm644 "${script}" "${pkgdir}/usr/share/mbv/scripts/${script##*/}"
    done
    install -Dm644 "fonts/Material-Design-Iconic-Font.ttf" \
        "${pkgdir}/usr/share/mbv/fonts/Material-Design-Iconic-Font.ttf"
    install -Dm644 "dist/config.toml" "${pkgdir}/usr/share/mbv/config.toml"
    install -Dm644 "contrib/mbvd.service" "${pkgdir}/usr/lib/systemd/system/mbvd.service"
    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/mbv/LICENSE"
}
