{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mbv",
  "identifier": "io.github.slatkin.mbv-gui",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mbv",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 200
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' mbv-art:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../assets/icon.png"]
  }
}
