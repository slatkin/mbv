{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window's grants (design D11): the bridge commands and the frame event listener, nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-key",
    "allow-pointer",
    "allow-report-layout",
    "allow-library",
    "allow-settings",
    "core:event:allow-listen"
  ]
}
