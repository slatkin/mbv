{
  "permissions": {
    "allow": [
      "Bash(grep -n *)",
      "Bash(rg *)",
      "Bash(gh issue *)",
      "Bash(grep -rn *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(grep -rln *)",
      "Bash(git show *)",
      "Bash(gh label *)",
      "Bash(git rev-parse *)",
      "Bash(find *)",
      "Bash(gh repo *)",
      "Bash(git fetch)",
      "Bash(gh pr *)",
      "Bash(cargo clippy *)"
    ]
  },
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // empty'); case \"$file\" in *.rs) rustfmt --edition 2021 \"$file\" ;; esac; exit 0"
          }
        ]
      }
    ]
  }
}